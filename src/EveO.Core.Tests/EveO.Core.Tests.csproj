<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>EveO.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EveO.Core\EveO.Core.csproj" />
    <ProjectReference Include="..\..\samples\EveO.Plugin.Sample\EveO.Plugin.Sample.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\EveO.Plugin.Broken\EveO.Plugin.Broken.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
  <!-- Os plugins de exemplo entram como ARQUIVO, nao como referencia: um plugin ja
       carregado no host e (corretamente) ignorado pelo loader. -->
  <Target Name="CopiaPluginsDeExemplo" AfterTargets="Build">
    <ItemGroup>
      <PluginDeExemplo Include="$(MSBuildThisFileDirectory)..\..\samples\EveO.Plugin.Sample\bin\$(Configuration)\net8.0\EveO.Plugin.Sample.dll" />
      <PluginQuebrado Include="$(MSBuildThisFileDirectory)..\..\samples\EveO.Plugin.Broken\bin\$(Configuration)\net8.0\EveO.Plugin.Broken.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDeExemplo)" DestinationFolder="$(OutDir)plugins-sample\sample" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginQuebrado)" DestinationFolder="$(OutDir)plugins-sample\broken" SkipUnchangedFiles="true" />
  </Target>

</Project>
